# SQLite-файл демонстрационной базы (путь относительно prisma/schema.prisma)
DATABASE_URL="file:./dev.db"
# Секрет подписи сессионных cookie: не менее 32 символов, уникальный для каждой установки
SESSION_SECRET="replace-with-random-string-at-least-32-characters"
# Пароли демонстрационных учётных записей, создаваемых seed-скриптом (необязательно)
# DEMO_ADMIN_PASSWORD=""
# DEMO_ENGINEER_PASSWORD=""
# DEMO_VIEWER_PASSWORD=""
